{
  "name": "kpi-tracker",
  "version": "2.0.0",
  "description": "KPI Tracker for Support Team",
  "main": "server.js",
  "engines": { "node": ">=18" },
  "scripts": {
    "start":      "node --env-file=.env server.js",
    "db:generate": "./node_modules/.bin/prisma generate",
    "db:push":     "./node_modules/.bin/prisma db push",
    "postinstall": "./node_modules/.bin/prisma generate",
    "pm2:start":   "npm install && ./node_modules/.bin/prisma db push && pm2 startOrRestart ecosystem.config.js"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "prisma": "^5.14.0"
  }
}
